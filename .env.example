# URL del backend (dominio de la API en producción)
VITE_API_URL=http://localhost:8080

# Ampaz Studio = tenant 2 en el backend compartido. Respaldo SOLO para desarrollo local — el
# backend (TenantInterceptor) resuelve la tienda por el dominio real de la solicitud (o por el
# JWT, una vez con sesión iniciada); este valor solo se usa cuando ninguno de los dos aplica
# (Vite en su propio puerto local, sin dominio registrado). En producción, con el dominio real
# de Ampaz Studio registrado, este valor NUNCA se usa — no hace falta cambiarlo ahí.
VITE_TENANT_ID=2

# PLACEHOLDER: el dominio real de Ampaz Studio, cuando esté decidido.
VITE_PUBLIC_SITE_URL=https://www.ampazstudio.com

# Client ID de Google OAuth (Google Cloud Console → Credentials).
# El dominio real desde el que se sirva esta tienda debe estar agregado
# UNA SOLA VEZ en "Authorized JavaScript origins" de ese Client ID.
VITE_GOOGLE_CLIENT_ID=608123125346-9iad9jvkl49j9f3hj5piipolbkjm1h56.apps.googleusercontent.com
